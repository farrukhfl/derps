# Security headers (must be real HTTP response headers -- browsers ignore
# X-Content-Type-Options and Permissions-Policy when only set via <meta>)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Every real app route is prerendered at build time as its own directory
# (see scripts/prerender.js), so it's already served directly by Apache's
# normal file/directory handling below -- nothing needs an index.html
# fallback. A path that matches neither is a genuinely unknown URL (a typo
# or a dead link), so it gets a real 404 response with the prerendered
# NotFound page's markup, instead of silently serving Home's markup with a
# 200 status -- which used to also make React hydrate the wrong page client-side.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>
ErrorDocument 404 /404.html
