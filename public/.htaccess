# Security headers (must be real HTTP response headers -- browsers ignore
# X-Content-Type-Options and Permissions-Policy when only set via <meta>)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Single-page app routing: serve index.html for any path that isn't a real file
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
